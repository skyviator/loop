NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Copy the local PUBLISHABLE_KEY value from: pnpm exec supabase status --output env
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local development only. Used by the server-only invitation activation path;
# never prefix with NEXT_PUBLIC and never use a production service-role key here.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Web Push. Generate a development-only pair with web-push; keep the private
# key server-only and leave all real values in ignored environment files.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Private Cloudflare R2 S3 API credentials. Server-only: never add NEXT_PUBLIC_.
# The endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com and region is auto.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_PRESIGN_TTL_SECONDS=300
