NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Copy the local PUBLISHABLE_KEY value from: pnpm exec supabase status --output env
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for verified media finalization, push delivery, and the
# narrow privileged invitation activation/delivery-state operations.
# Use an environment-specific key and never prefix this variable with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Transactional invitation email. Keep all provider values server-only and use
# separate credentials for staging and production. Local development previews
# invitation links without a provider when RESEND_API_KEY is blank.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SUPPORT_ADDRESS=

# Web Push. Generate a separate pair for each environment; keep the private key
# server-only and leave all real values in ignored environment files/secret stores.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Dedicated server-to-server credential for the bounded push retry endpoint.
# Store a separate random value per environment; never prefix it NEXT_PUBLIC_.
PUSH_WORKER_SECRET=

# Private Cloudflare R2 S3 API credentials. Server-only: never add NEXT_PUBLIC_.
# The endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com and region is auto.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_PRESIGN_TTL_SECONDS=300
