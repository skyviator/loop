{
  "name": "@loop/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run lib",
    "test:pwa": "vitest run lib/pwa/service-worker.test.ts lib/push/policy.test.ts",
    "seed:local": "node scripts/seed-local.mjs",
    "seed:staging": "node scripts/seed-staging.mjs",
    "test:staging-seed": "node --test scripts/staging-target.test.mjs",
    "test:r2": "node --env-file=.env.local scripts/verify-r2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/s3-request-presigner": "3.1127.0",
    "@loop/brand": "workspace:*",
    "@loop/domain": "workspace:*",
    "@loop/types": "workspace:*",
    "@loop/validation": "workspace:*",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4"
  }
}
